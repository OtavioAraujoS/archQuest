<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_onboarding" targetNamespace="http://archquest.dev/templates">
  <bpmn:collaboration id="Collaboration_onboarding">
    <bpmn:participant id="Participant_onboarding" name="Onboarding de funcionário" processRef="Process_onboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Process_onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_onboarding">
      <bpmn:lane id="Lane_rh" name="RH">
        <bpmn:flowNodeRef>Start_contratacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_documentacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_divisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_juncao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_integracao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_integrado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ti" name="TI">
        <bpmn:flowNodeRef>Task_acessos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gestor" name="Gestor">
        <bpmn:flowNodeRef>Task_primeira_semana</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_contratacao" name="Contratação aprovada">
      <bpmn:outgoing>Flow_inicio_documentacao</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_documentacao" name="Preparar documentação">
      <bpmn:incoming>Flow_inicio_documentacao</bpmn:incoming>
      <bpmn:outgoing>Flow_documentacao_divisao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_divisao">
      <bpmn:incoming>Flow_documentacao_divisao</bpmn:incoming>
      <bpmn:outgoing>Flow_divisao_acessos</bpmn:outgoing>
      <bpmn:outgoing>Flow_divisao_semana</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_acessos" name="Criar acessos e e-mail">
      <bpmn:incoming>Flow_divisao_acessos</bpmn:incoming>
      <bpmn:outgoing>Flow_acessos_juncao</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_primeira_semana" name="Planejar a primeira semana">
      <bpmn:incoming>Flow_divisao_semana</bpmn:incoming>
      <bpmn:outgoing>Flow_semana_juncao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_juncao">
      <bpmn:incoming>Flow_acessos_juncao</bpmn:incoming>
      <bpmn:incoming>Flow_semana_juncao</bpmn:incoming>
      <bpmn:outgoing>Flow_juncao_integracao</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_integracao" name="Integração no primeiro dia">
      <bpmn:incoming>Flow_juncao_integracao</bpmn:incoming>
      <bpmn:outgoing>Flow_integracao_fim</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_integrado" name="Colaborador integrado">
      <bpmn:incoming>Flow_integracao_fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_inicio_documentacao" sourceRef="Start_contratacao" targetRef="Task_documentacao" />
    <bpmn:sequenceFlow id="Flow_documentacao_divisao" sourceRef="Task_documentacao" targetRef="Gateway_divisao" />
    <bpmn:sequenceFlow id="Flow_divisao_acessos" sourceRef="Gateway_divisao" targetRef="Task_acessos" />
    <bpmn:sequenceFlow id="Flow_divisao_semana" sourceRef="Gateway_divisao" targetRef="Task_primeira_semana" />
    <bpmn:sequenceFlow id="Flow_acessos_juncao" sourceRef="Task_acessos" targetRef="Gateway_juncao" />
    <bpmn:sequenceFlow id="Flow_semana_juncao" sourceRef="Task_primeira_semana" targetRef="Gateway_juncao" />
    <bpmn:sequenceFlow id="Flow_juncao_integracao" sourceRef="Gateway_juncao" targetRef="Task_integracao" />
    <bpmn:sequenceFlow id="Flow_integracao_fim" sourceRef="Task_integracao" targetRef="End_integrado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_onboarding">
    <bpmndi:BPMNPlane id="Plane_onboarding" bpmnElement="Collaboration_onboarding">
      <bpmndi:BPMNShape id="Participant_onboarding_di" bpmnElement="Participant_onboarding" isHorizontal="true"><dc:Bounds x="160" y="80" width="900" height="390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_rh_di" bpmnElement="Lane_rh" isHorizontal="true"><dc:Bounds x="190" y="80" width="870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ti_di" bpmnElement="Lane_ti" isHorizontal="true"><dc:Bounds x="190" y="210" width="870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_gestor_di" bpmnElement="Lane_gestor" isHorizontal="true"><dc:Bounds x="190" y="340" width="870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_contratacao_di" bpmnElement="Start_contratacao"><dc:Bounds x="232" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_documentacao_di" bpmnElement="Task_documentacao"><dc:Bounds x="320" y="105" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_divisao_di" bpmnElement="Gateway_divisao"><dc:Bounds x="465" y="120" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_acessos_di" bpmnElement="Task_acessos"><dc:Bounds x="560" y="235" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_primeira_semana_di" bpmnElement="Task_primeira_semana"><dc:Bounds x="560" y="365" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_juncao_di" bpmnElement="Gateway_juncao"><dc:Bounds x="705" y="120" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_integracao_di" bpmnElement="Task_integracao"><dc:Bounds x="800" y="105" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_integrado_di" bpmnElement="End_integrado"><dc:Bounds x="962" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_inicio_documentacao_di" bpmnElement="Flow_inicio_documentacao"><di:waypoint x="268" y="145" /><di:waypoint x="320" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_documentacao_divisao_di" bpmnElement="Flow_documentacao_divisao"><di:waypoint x="420" y="145" /><di:waypoint x="465" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_divisao_acessos_di" bpmnElement="Flow_divisao_acessos"><di:waypoint x="490" y="170" /><di:waypoint x="490" y="275" /><di:waypoint x="560" y="275" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_divisao_semana_di" bpmnElement="Flow_divisao_semana"><di:waypoint x="490" y="170" /><di:waypoint x="490" y="405" /><di:waypoint x="560" y="405" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_acessos_juncao_di" bpmnElement="Flow_acessos_juncao"><di:waypoint x="660" y="275" /><di:waypoint x="730" y="275" /><di:waypoint x="730" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_semana_juncao_di" bpmnElement="Flow_semana_juncao"><di:waypoint x="660" y="405" /><di:waypoint x="730" y="405" /><di:waypoint x="730" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_juncao_integracao_di" bpmnElement="Flow_juncao_integracao"><di:waypoint x="755" y="145" /><di:waypoint x="800" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_integracao_fim_di" bpmnElement="Flow_integracao_fim"><di:waypoint x="900" y="145" /><di:waypoint x="962" y="145" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
