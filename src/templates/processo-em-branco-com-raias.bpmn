    <bpmn:startEvent id="Start_inicio" name="Início" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_em_branco">
    <bpmndi:BPMNPlane id="Plane_em_branco" bpmnElement="Collaboration_em_branco">
      <bpmndi:BPMNShape id="Participant_processo_di" bpmnElement="Participant_processo" isHorizontal="true"><dc:Bounds x="160" y="80" width="700" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_primeira_di" bpmnElement="Lane_primeira" isHorizontal="true"><dc:Bounds x="190" y="80" width="670" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_segunda_di" bpmnElement="Lane_segunda" isHorizontal="true"><dc:Bounds x="190" y="210" width="670" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_inicio_di" bpmnElement="Start_inicio"><dc:Bounds x="242" y="127" width="36" height="36" /></bpmndi:BPMNShape>
